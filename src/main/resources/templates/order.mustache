<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>주문 및 결제</title>

    <!-- jQuery 추가 -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- 아임포트 결제 라이브러리 추가 -->
    <script src="https://cdn.iamport.kr/js/iamport.payment-1.1.8.js"></script>

    <script>
        function handlePayment() {
            var IMP = window.IMP;
            IMP.init('{{impUserCode}}'); // 아임포트 사용자 코드

            var orderInfo = {
                pg: "html5_inicis", // PG사 MID 설정
                pay_method: document.getElementById("payMethod").value,
                merchant_uid: "{{merchantUid}}",
                name: "{{productName}}",
                amount: "{{totalPrice}}",
                buyer_name: document.getElementById("ordererName").value,
                buyer_tel: document.getElementById("phoneNumber").value,
                buyer_postcode: document.getElementById("postCode").value,
                buyer_addr: document.getElementById("address").value
            };

            IMP.request_pay(orderInfo, function (rsp) {
                if (rsp.success) {
                    fetch("/api/v1/payment/verify/" + rsp.imp_uid, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            memberId: "{{memberId}}",
                            orderId: "{{orderId}}",
                            price: "{{totalPrice}}",
                        })
                    }).then(response => response.json())
                            .then(data => {
                                alert("결제가 성공적으로 완료되었습니다.");
                                window.location.href = "/payment/success";
                            })
                            .catch(error => {
                                console.error("결제 처리 중 오류 발생:", error);
                                alert("결제 처리 중 오류가 발생했습니다.");
                            });
                } else {
                    alert("결제에 실패했습니다. 오류: " + rsp.error_msg);
                }
            });
        }
    </script>
</head>
<body>
<h2>주문 및 결제</h2>
<form>
    <label for="ordererName">주문자 이름:</label>
    <input type="text" id="ordererName" name="ordererName" required><br>

    <label for="phoneNumber">전화번호:</label>
    <input type="text" id="phoneNumber" name="phoneNumber" required><br>

    <label for="postCode">우편번호:</label>
    <input type="text" id="postCode" name="postCode" required><br>

    <label for="address">주소:</label>
    <input type="text" id="address" name="address" required><br>

    <label for="detailAddress">상세주소:</label>
    <input type="text" id="detailAddress" name="detailAddress" required><br>

    <label for="payMethod">결제 방법:</label>
    <select id="payMethod" name="payMethod">
        <option value="CARD">카드결제</option>
        <option value="TRANS">계좌이체</option>
        <option value="VBANK">가상계좌</option>
        <option value="PHONE">휴대폰결제</option>
    </select><br>

    <button type="button" onclick="handlePayment()">결제하기</button>
</form>
</body>
</html>
